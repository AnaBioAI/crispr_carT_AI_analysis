
############################################################
# 📁 DATA MANAGEMENT
############################################################

# Ignore only RAW data — usually large GEO files
data/raw/

# Keep processed data (logCPM, normalized matrices, metadata)
# (Essential for reproducibility)
# data/processed/   <-- leave tracked

############################################################
# 🐍 PYTHON ARTIFACTS
############################################################

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyo

# Virtual environment folders
env/
venv/
.crispr_carT_env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Logs
*.log
nohup.out

############################################################
# 🧪 JUPYTER / LAB UTILITIES
############################################################

# Local JupyterLab config/cache
.jupyter/
.lab/
.jupyter_lab.log

############################################################
# 🧬 PROJECT-SPECIFIC ARTIFACTS
############################################################

# Backup scripts created by your auto-backup system
zshrc_backup*.txt

# Temporary outputs
tmp/
scratch/
cache/

############################################################
# 🖥 OS JUNK (macOS)
############################################################

.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

############################################################
# 🧰 EDITOR / IDE FILES
############################################################

# VSCode
.vscode/

# PyCharm
.idea/

############################################################
# 🚀 MODEL / LARGE FILE TYPES TO IGNORE BY DEFAULT
############################################################

*.h5
*.hdf5
*.joblib
*.pkl
*.pickle

# Allow PCA classifiers (small) unless you decide otherwise
# results/pca/*.joblib  <-- not ignored; tracked

############################################################
# 🔬 RESULTS — ALLOW EVERYTHING (important for science)
############################################################

# Do NOT ignore results/ — figures, CSVs, PCA results,
# quadrant classifiers, etc. should all remain tracked.
# =====================
# OS junk
# =====================
.DS_Store

# =====================
# Jupyter
# =====================
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# =====================
# Python
# =====================
__pycache__/
*.pyc

# =====================
# Logs
# =====================
jupyter.log

# =====================
# Temporary / editor files
# =====================
*.swp
*.tmp


.DS_Store
.ipynb_checkpoints/
__pycache__/
*.log
results/.DS_Store

# =====================
# Raw or large data
# =====================
data/raw/
*.fastq
*.bam
*.sam
*.fq
*.tar.gz
*.docx
~$*.docx
~$*.docx
*.pptx
